{
  "name": "jam-toolchain-preparation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Environment checks only; not a game or game scaffold",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
